# ==============================================================================
# SWAMIDATT ENTERPRISES ERP POS Billing System - Backend Environment Configuration
# ==============================================================================

# Production PostgreSQL (e.g. Render PostgreSQL / Supabase / AWS RDS):
# Paste the Internal or External Database URL provided by Render:
# DATABASE_URL=postgresql://username:password@hostname:5432/ajay_footwear

# Local Development PostgreSQL Fallback (used when DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ajay_footwear
DB_USER=postgres
DB_PASSWORD=your_local_db_password

# Server Runtime:
PORT=5000
FLASK_ENV=production
DEBUG=false

# Allowed Frontend Origins for CORS:
# Set to your deployed Render Static Site URL (e.g. https://swamidatt-footwear.onrender.com)
# Multiple origins can be comma-separated: https://site1.onrender.com,https://site2.onrender.com
CORS_ORIGINS=https://your-frontend-app.onrender.com
